# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL Connection String (Coolify / Hostinger VPS)
# Internal Coolify format: postgresql://postgres:SENHA@postgresql-mdtracker:5432/postgres
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/postgres"

