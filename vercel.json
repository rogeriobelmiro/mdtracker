{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/lp/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/pesquisa/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/survey/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/w/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/tracker/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
